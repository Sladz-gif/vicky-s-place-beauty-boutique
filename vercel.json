{
  "buildCommand": "npm run build",
  "outputDirectory": ".output",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
